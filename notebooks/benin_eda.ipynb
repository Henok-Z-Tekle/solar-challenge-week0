{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Benin — Solar EDA\n",
    "\n",
    "Objectives:\n",
    "- Summary stats and missing values (>5%)\n",
    "- Outlier detection via Z-scores (|Z|>3) for GHI, DNI, DHI, ModA, ModB, WS, WSgust\n",
    "- Clean key columns by median imputation and export cleaned CSV to `data/benin_clean.csv`\n",
    "- Time series patterns (daily, monthly), and anomalies\n",
    "- Cleaning impact on ModA/ModB\n",
    "- Correlations and scatter relationships\n",
    "- Wind rose and distributions\n",
    "- Temperature/RH analysis and bubble chart (GHI vs Tamb; size RH/BP)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os, warnings\n",
    "from math import pi\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "plotting_available = True\n",
    "try:\n",
    "    import matplotlib.pyplot as plt\n",
    "    import seaborn as sns\n",
    "    sns.set(style='whitegrid')\n",
    "except Exception as e:\n",
    "    plotting_available = False\n",
    "    print(f'Plotting libraries not available: {e}')\n",
    "\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "def find_column(df, candidates):\n",
    "    for c in candidates:\n",
    "        if c in df.columns: return c\n",
    "        if c.lower() in [col.lower() for col in df.columns]:\n",
    "            return next(col for col in df.columns if col.lower()==c.lower())\n",
    "    return None\n",
    "\n",
    "def guess_timestamp_col(df):\n",
    "    return find_column(df, ['Timestamp','TIMESTAMP','ts','time','Time','DATE','Date','Datetime','datetime'])\n",
    "\n",
    "def ensure_datetime_index(df, ts_col):\n",
    "    if ts_col is None:\n",
    "        raise ValueError('No timestamp-like column found. Please set ts_col manually.')\n",
    "    df = df.copy()\n",
    "    df['Timestamp'] = pd.to_datetime(df[ts_col], errors='coerce', utc=False)\n",
    "    df = df.dropna(subset=['Timestamp']).sort_values('Timestamp')\n",
    "    df = df.set_index('Timestamp')\n",
    "    return df\n",
    "\n",
    "def compute_add_zscores(df, cols):\n",
    "    present = [c for c in cols if c in df.columns]\n",
    "    if not present: return []\n",
    "    z = (df[present] - df[present].mean())/df[present].std(ddof=0)\n",
    "    for c in present:\n",
    "        df[f'{c}_z'] = z[c]\n",
    "        df[f'{c}_outlier'] = z[c].abs() > 3\n",
    "    return present\n",
    "\n",
    "def median_impute_inplace(df, cols):\n",
    "    for c in cols:\n",
    "        if c in df.columns and df[c].isna().any():\n",
    "            df[c].fillna(df[c].median(), inplace=True)\n",
    "\n",
    "def wind_rose_plot(df, ws_col='WS', wd_col='WD', bins=16, title='Wind Rose', save_path=None):\n",
    "    if not plotting_available: return\n",
    "    if ws_col not in df.columns or wd_col not in df.columns: return\n",
    "    data = df[[ws_col, wd_col]].dropna()\n",
    "    if data.empty: return\n",
    "    directions = np.deg2rad(data[wd_col] % 360.0)\n",
    "    # bin directions\n",
    "    edges = np.linspace(0, 2*np.pi, bins+1)\n",
    "    idx = np.digitize(directions, edges) - 1\n",
    "    idx[idx==bins] = 0\n",
    "    speedsum = np.zeros(bins)\n",
    "    counts = np.zeros(bins)\n",
    "    for i, ws in zip(idx, data[ws_col].values):\n",
    "        speedsum[i] += max(ws, 0)\n",
    "        counts[i] += 1\n",
    "    mean_ws = np.divide(speedsum, counts, out=np.zeros_like(speedsum), where=counts>0)\n",
    "    theta = edges[:-1] + (edges[1]-edges[0])/2\n",
    "    width = (2*np.pi)/bins\n",
    "    ax = plt.subplot(111, projection='polar')\n",
    "    bars = ax.bar(theta, mean_ws, width=width, bottom=0.0, align='center', alpha=0.7)\n",
    "    ax.set_title(title)\n",
    "    if save_path: plt.savefig(save_path, bbox_inches='tight', dpi=150)\n",
    "    plt.show()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Configuration\n",
    "country = 'Benin'\n",
    "raw_path = r'c:\\Users\\heniz\\Downloads\\data\\data\\benin-malanville.csv'\n",
    "output_dir = 'data'\n",
    "fig_dir = 'figures'\n",
    "os.makedirs(output_dir, exist_ok=True)\n",
    "os.makedirs(fig_dir, exist_ok=True)\n",
    "cleaned_path = os.path.join(output_dir, f"{country.lower()}_clean.csv")\n",
    "raw_path\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load data\n",
    "df = pd.read_csv(raw_path, low_memory=False)\n",
    "print('Loaded shape:', df.shape)\n",
    "print('Columns:', list(df.columns))\n",
    "ts_col = guess_timestamp_col(df)\n",
    "df = ensure_datetime_index(df, ts_col)\n",
    "print('After datetime index -> shape:', df.shape)\n",
    "df.head(3)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Summary statistics & missing-value report\n",
    "num_cols = df.select_dtypes(include=[np.number]).columns.tolist()\n",
    "display(df[num_cols].describe().T) if num_cols else print('No numeric columns found.')\n",
    "na_counts = df.isna().sum().sort_values(ascending=False)\n",
    "na_pct = (na_counts / len(df)) * 100\n",
    "missing_over_5 = na_pct[na_pct > 5] if len(df) else pd.Series(dtype=float)\n",
    "print('Missing values per column:')\n",
    "display(pd.DataFrame({'na_count': na_counts, 'na_pct': na_pct}).query('na_count>0'))\n",
    "print('Columns with >5% nulls:')\n",
    "display(missing_over_5)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Outlier detection via Z-scores\n",
    "cols_interest = ['GHI','DNI','DHI','ModA','ModB','WS','WSgust']\n",
    "present = compute_add_zscores(df, cols_interest)\n",
    "if present:\n",
    "    flag_cols = [f'{c}_outlier' for c in present]\n",
    "    outlier_rows = df[flag_cols].any(axis=1).sum()\n",
    "    print(f'Outlier-flagged rows (any metric): {outlier_rows} / {len(df)}')\n",
    "else:\n",
    "    print('No target columns present for outlier detection.')\n",
    "df.filter(regex='_z$|_outlier$').head()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Basic cleaning: median imputation for key columns\n",
    "key_cols = ['GHI','DNI','DHI','ModA','ModB','WS','WSgust','Tamb']\n",
    "present_keys = [c for c in key_cols if c in df.columns]\n",
    "median_impute_inplace(df, present_keys)\n",
    "# Export cleaned CSV (index is Timestamp)\n",
    "df.to_csv(cleaned_path, index=True)\n",
    "cleaned_path\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Time series analysis: lines by Timestamp\n",
    "if plotting_available:\n",
    "    ts_cols = [c for c in ['GHI','DNI','DHI','Tamb'] if c in df.columns]\n",
    "    if ts_cols:\n",
    "        ax = df[ts_cols].plot(figsize=(12,5), title='Time Series: GHI/DNI/DHI/Tamb')\n",
    "        plt.ylabel('Value')\n",
    "        plt.show()\n",
    "        # Monthly mean patterns\n",
    "        monthly = df[ts_cols].resample('M').mean()\n",
    "        monthly.plot(figsize=(12,4), title='Monthly Mean Patterns')\n",
    "        plt.show()\n",
    "        # Hour-of-day patterns\n",
    "        hod = df[ts_cols].groupby(df.index.hour).mean()\n",
    "        hod.plot(figsize=(10,4), marker='o', title='Hour-of-Day Mean')\n",
    "        plt.xlabel('Hour of Day')\n",
    "        plt.show()\n",
    "    else:\n",
    "        print('No expected time-series columns found to plot.')\n",
    "else:\n",
    "    print('Plotting not available; skipping charts.')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cleaning impact: group by Cleaning flag (if present) and compare ModA/ModB\n",
    "clean_col = find_column(df, ['Cleaning','Clean','PanelCleaned','CLEANING'])\n",
    "mods = [c for c in ['ModA','ModB'] if c in df.columns]\n",
    "if plotting_available and clean_col and len(mods)>=1:\n",
    "    grp = df.groupby(df[clean_col].astype(int))[mods].mean()\n",
    "    grp.plot(kind='bar', figsize=(8,4), title='Average ModA/ModB by Cleaning Flag')\n",
    "    plt.xlabel('Cleaning Flag')\n",
    "    plt.ylabel('Average')\n",
    "    plt.show()\n",
    "else:\n",
    "    print('Cleaning flag or ModA/ModB not available for impact plot.')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Correlation & relationships\n",
    "corr_cols = [c for c in ['GHI','DNI','DHI','TModA','TModB'] if c in df.columns]\n",
    "if len(corr_cols) >= 2:\n",
    "    corr = df[corr_cols].corr()\n",
    "    if plotting_available:\n",
    "        plt.figure(figsize=(5,4))\n",
    "        sns.heatmap(corr, annot=True, cmap='viridis', fmt='.2f')\n",
    "        plt.title('Correlation Heatmap')\n",
    "        plt.show()\n",
    "    display(corr)\n",
    "else:\n",
    "    print('Not enough columns for correlation heatmap.')\n",
    "\n",
    "# Scatter plots\n",
    "pairs = [\n",
    "    ('WS','GHI'), ('WSgust','GHI'), ('WD','GHI'),\n",
    "    ('RH','Tamb'), ('RH','GHI')\n",
    "]\n",
    "if plotting_available:\n",
    "    for x,y in pairs:\n",
    "        if x in df.columns and y in df.columns:\n",
    "            plt.figure(figsize=(5,4))\n",
    "            sns.scatterplot(data=df, x=x, y=y, s=10, alpha=0.5)\n",
    "            plt.title(f'{x} vs {y}')\n",
    "            plt.show()\n",
    "else:\n",
    "    print('Plotting not available; skipping scatter plots.')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Wind rose and distributions\n",
    "if plotting_available:\n",
    "    if 'WS' in df.columns and 'WD' in df.columns:\n",
    "        wind_rose_plot(df, 'WS','WD', bins=16, title='Wind Rose — Benin')\n",
    "    # Histograms\n",
    "    hist_cols = [c for c in ['GHI','WS'] if c in df.columns]\n",
    "    for c in hist_cols:\n",
    "        plt.figure(figsize=(5,4))\n",
    "        sns.histplot(df[c].dropna(), kde=True, bins=40)\n",
    "        plt.title(f'Histogram — {c}')\n",
    "        plt.show()\n",
    "else:\n",
    "    print('Plotting not available; skipping wind/distribution plots.')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Temperature analysis and bubble chart\n",
    "if 'RH' in df.columns and 'Tamb' in df.columns:\n",
    "    print('RH vs Tamb correlation:', df[['RH','Tamb']].corr().iloc[0,1])\n",
    "if plotting_available:\n",
    "    # Bubble chart: GHI vs Tamb with bubble size RH or BP\n",
    "    x,y = None, None\n",
    "    if 'GHI' in df.columns and 'Tamb' in df.columns:\n",
    "        x, y = 'GHI','Tamb'\n",
    "    size_col = 'RH' if 'RH' in df.columns else ('BP' if 'BP' in df.columns else None)\n",
    "    if x and y and size_col:\n",
    "        s = (df[size_col].fillna(df[size_col].median()) if size_col in df.columns else pd.Series(10, index=df.index))\n",
    "        s_scaled = 20 + 2*(s - s.min())/(s.max()-s.min()+1e-9) * 80\n",
    "        plt.figure(figsize=(6,5))\n",
    "        plt.scatter(df[x], df[y], s=s_scaled, alpha=0.3, c=df.get('DNI', df.get('GHI', pd.Series(1, index=df.index))), cmap='viridis')\n",
    "        plt.xlabel(x); plt.ylabel(y); plt.title(f'Bubble: {x} vs {y} (size={size_col})')\n",
    "        cbar = plt.colorbar(); cbar.set_label('DNI/GHI scale')\n",
    "        plt.show()\n",
    "    else:\n",
    "        print('Insufficient columns for bubble chart.')\n",
    "else:\n",
    "    print('Plotting not available; skipping bubble chart.')\n"
   ]
  }
 ],
